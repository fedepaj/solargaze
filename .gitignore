.DS_Store
node_modules/
*.log

# The Pages workflow uploads the repository root verbatim, so anything
# committed here is also published. Keep working files out of both.
graphify-out/
.claude/settings.local.json

# Maintenance scripts, not part of the site. redact.py burns the redactions
# into the guide screenshots; the results are committed, the tool is not.
# The clip recorder is kept: the clips are re-recorded whenever the
# interface changes, and it holds no secret (the token is in pipeline/.env).
tools/*
!tools/record/

# Source material for docs/ — full-res screenshots and the frames the GIF
# was built from. Working files: not part of the site, so not published.
solargaze-assets/

# The offline pipeline's own environment and raw downloads; the inputs are
# re-fetchable. (pipeline/cache is a symlink to an external disk, which a
# trailing slash would not match.)
pipeline/.venv/
pipeline/cache
pipeline/cache.local-backup/
__pycache__/

# The pipeline's output lives in the R2 bucket the app reads
# (pipeline/publish_tiles.py), not in git: a country of tiles would outgrow
# a Pages site and weigh down every clone.
data/tiles/

# Secrets for the pipeline (R2 and OpenAQ keys); see pipeline/.env.
.env

# A stray copy of a Claude config directory, created by a command that took
# "~" literally.
/~/
